{
  "manifest_version": 3,
  "name": "__MSG_storeName__",
  "short_name": "Findy",
  "description": "__MSG_storeDescription__",
  "default_locale": "en",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "__MSG_title__",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+F" } }
  },
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "chromium": {
    "key": "",
    "minimum_chrome_version": "116"
  },
  "firefox": {
    "browser_specific_settings": { "gecko": { "strict_min_version": "128.0" } }
  }
}
