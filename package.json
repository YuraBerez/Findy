{
  "name": "findy",
  "productName": "Findy",
  "version": "0.4.1",
  "description": "Open-source desktop app to track your job search",
  "license": "MIT",
  "author": "Findy contributors",
  "homepage": "https://github.com/YuraBerez/findy",
  "repository": {
    "type": "git",
    "url": "https://github.com/YuraBerez/findy.git"
  },
  "bugs": "https://github.com/YuraBerez/findy/issues",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "npm run build && node scripts/e2e-ci.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check .",
    "screenshots": "npm run build && UPDATE_SCREENSHOTS=1 playwright test self-tests/readme-screenshots --workers=1"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "i18next": "^27.1.3",
    "playwright-e2e-kit": "github:YuraBerez/playwright-e2e-kit#v0.3.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "better-sqlite3": false,
    "fsevents": false
  }
}
