{
  "name": "findy",
  "productName": "Findy",
  "version": "0.1.0",
  "description": "Open-source desktop app to track your job search",
  "license": "MIT",
  "author": "Findy contributors",
  "homepage": "https://github.com/YuraBerez/findy",
  "repository": {
    "type": "git",
    "url": "https://github.com/YuraBerez/findy.git"
  },
  "bugs": "https://github.com/YuraBerez/findy/issues",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "better-sqlite3": false
  }
}
