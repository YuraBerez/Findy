{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@shared/*": ["./src/shared/*"],
      "@ui": ["./src/renderer/ui"],
      "@styles/*": ["./src/renderer/styles/*"]
    }
  },
  "include": [
    "src/extension/**/*",
    "src/renderer/ui/**/*",
    "src/shared/**/*",
    "src/domain/**/*",
    "tests/unit/extension/**/*"
  ]
}
