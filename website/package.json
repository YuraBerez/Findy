{
  "name": "findy-website",
  "description": "The Findy website (spec 020), published to GitHub Pages",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . && astro check",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:built": "vitest run --project built",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "astro": "^7.4.13",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "node-html-parser": "^9.0.7",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "unist-util-visit": "^5.2.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "fsevents": false
  }
}
