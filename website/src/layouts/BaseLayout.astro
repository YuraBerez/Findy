---
import { getImage } from 'astro:assets'
import logo from '../../../assets/logo.svg'
import boardEn from '../../../docs/screenshots/board-en.png'
import boardUk from '../../../docs/screenshots/board-uk.png'
import boardPl from '../../../docs/screenshots/board-pl.png'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { MESSAGES } from '../i18n'
import { GOOGLE_SITE_VERIFICATION } from '../lib/site'
import { THEME_KEY } from '../lib/theme'
import { DEFAULT_LANG, LANGS, pagePath, withBase, type Lang, type PageKey } from '../lib/paths'
import '../styles/global.css'

interface Props {
  lang: Lang
  page: PageKey
  title: string
  description: string
  /** FR-040: schema.org data for search engines (the home page) */
  structuredData?: Record<string, unknown> | undefined
  /** The 404 page: no index, no canonical and no language links */
  notFound?: boolean
}

/** FR-040, spec 027 FR-005: the locale of each language for social networks */
const OG_LOCALES: Record<Lang, string> = { en: 'en_US', uk: 'uk_UA', pl: 'pl_PL' }
const { lang, page, title, description, structuredData, notFound = false } = Astro.props
const t = MESSAGES[lang]
const base = import.meta.env.BASE_URL
const absolute = (path: string) => new URL(path, Astro.site).href
const urlOf = (l: Lang) => absolute(withBase(base, pagePath(l, page)))
// FR-041: the preview is the board in the language of the page
const preview = await getImage({
  src: { en: boardEn, uk: boardUk, pl: boardPl }[lang],
  width: 1200,
  format: 'png',
})
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    {notFound && <meta name="robots" content="noindex" />}
    {!notFound && <link rel="canonical" href={urlOf(lang)} />}
    {!notFound && LANGS.map((l) => <link rel="alternate" hreflang={l} href={urlOf(l)} />)}
    {!notFound && <link rel="alternate" hreflang="x-default" href={urlOf(DEFAULT_LANG)} />}
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="sitemap" href={withBase(base, 'sitemap.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Findy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlOf(lang)} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta property="og:image" content={absolute(preview.src)} />
    <meta property="og:image:width" content={String(preview.attributes.width)} />
    <meta property="og:image:height" content={String(preview.attributes.height)} />
    <meta property="og:image:alt" content={t.screenshots.board} />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
    {/* NFR-003: the theme that the visitor picked, before the first paint (so inline) */}
    <script is:inline define:vars={{ key: THEME_KEY }}>
      // Scripts run: the mobile menu can start closed (Header)
      document.documentElement.dataset.js = ''
      try {
        const theme = localStorage.getItem(key)
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {
        // No storage: the system theme applies
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {t.nav.skip}
    </a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
