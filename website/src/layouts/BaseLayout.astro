---
import { getImage } from 'astro:assets'
import logo from '../../../assets/logo.svg'
import boardEn from '../../../docs/screenshots/board-en.png'
import boardUk from '../../../docs/screenshots/board-uk.png'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { MESSAGES } from '../i18n'
import { DEFAULT_LANG, LANGS, pagePath, withBase, type Lang, type PageKey } from '../lib/paths'
import '../styles/global.css'

interface Props {
  lang: Lang
  page: PageKey
  title: string
  description: string
}

const { lang, page, title, description } = Astro.props
const t = MESSAGES[lang]
const base = import.meta.env.BASE_URL
const absolute = (path: string) => new URL(path, Astro.site).href
const urlOf = (l: Lang) => absolute(withBase(base, pagePath(l, page)))
// FR-041: the preview is the board in the language of the page
const preview = await getImage({
  src: lang === 'uk' ? boardUk : boardEn,
  width: 1200,
  format: 'png',
})
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlOf(lang)} />
    {LANGS.map((l) => (
      <link rel="alternate" hreflang={l} href={urlOf(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={urlOf(DEFAULT_LANG)} />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="sitemap" href={withBase(base, 'sitemap.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Findy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlOf(lang)} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta property="og:image" content={absolute(preview.src)} />
    <meta property="og:image:alt" content={t.screenshots.board} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">
      {t.nav.skip}
    </a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
