---
import { NEW_ISSUE_URL, PROJECT_URL, SOURCE_URL, SUPPORT_URL } from '../../../src/shared/project'
import { MESSAGES } from '../i18n'
import { GUIDES } from '../lib/guides'
import { guidePage, pagePath, withBase, type Lang } from '../lib/paths'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = MESSAGES[lang]
const base = import.meta.env.BASE_URL
// FR-022: every guide; FR-023, US-5: support, source, issues, licence
const guides = GUIDES.map((slug) => ({
  href: withBase(base, pagePath(lang, guidePage(slug))),
  text: t.guides[slug],
}))
const project = [
  { href: SUPPORT_URL, text: t.footer.support },
  { href: PROJECT_URL, text: t.footer.source },
  { href: NEW_ISSUE_URL, text: t.footer.issues },
  { href: `${SOURCE_URL}LICENSE`, text: t.footer.licence },
]
---

<footer class="footer">
  <div class="container columns">
    <nav aria-label={t.nav.guides}>
      <h2>{t.nav.guides}</h2>
      <ul>
        {guides.map((link) => (
          <li>
            <a href={link.href}>{link.text}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div>
      <h2>Findy</h2>
      <ul>
        {project.map((link) => (
          <li>
            <a href={link.href}>{link.text}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="container muted">{t.footer.notAffiliated}</p>
</footer>

<style>
  .footer {
    margin-top: var(--space-10);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .columns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-10);
  }
  h2 {
    margin: 0 0 var(--space-2);
    font-size: 1rem;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
