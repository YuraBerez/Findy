---
import logo from '../../../assets/logo.svg'
import { NEW_ISSUE_URL, PROJECT_URL, SOURCE_URL, SUPPORT_URL } from '../../../src/shared/project'
import { MESSAGES, format } from '../i18n'
import { GUIDES } from '../lib/guides'
import { guidePage, pagePath, withBase, type Lang } from '../lib/paths'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = MESSAGES[lang]
const base = import.meta.env.BASE_URL
// FR-022: every guide; FR-023, US-5: support, source, issues, licence
const columns = [
  {
    title: t.nav.guides,
    links: GUIDES.map((slug) => ({
      href: withBase(base, pagePath(lang, guidePage(slug))),
      text: t.guides[slug],
    })),
  },
  {
    title: t.footer.project,
    links: [
      { href: PROJECT_URL, text: t.footer.source },
      { href: NEW_ISSUE_URL, text: t.footer.issues },
      { href: SUPPORT_URL, text: t.footer.support },
    ],
  },
]
const year = String(new Date().getFullYear())
---

<footer class="footer">
  <div class="container top">
    <div class="brand">
      <a class="name" href={withBase(base, pagePath(lang))}>
        <img src={logo.src} alt="" width="28" height="28" />
        <span>Findy</span>
      </a>
      <p class="muted">{t.hero.title}</p>
    </div>
    {columns.map((column) => (
      <nav aria-label={column.title}>
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li>
              <a href={link.href}>{link.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="container bottom muted">
    <p>
      {format(t.footer.copyright, { year })} ·{' '}
      <a href={`${SOURCE_URL}LICENSE`}>{t.footer.licence}</a>
    </p>
    <p>{t.footer.notAffiliated}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-10);
    border-top: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.95rem;
  }
  .top {
    display: grid;
    grid-template-columns: 2fr repeat(2, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-10) var(--space-6);
  }
  @media (max-width: 640px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  .name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--fg);
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
  }
  .brand p {
    margin: var(--space-2) 0 0;
  }
  h2 {
    margin: 0 0 12px;
    color: var(--fg-muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    color: var(--fg);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--primary);
    text-decoration: underline;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .bottom p {
    margin: 0;
  }
  .bottom a {
    color: inherit;
  }
</style>
