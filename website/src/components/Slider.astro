---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { MESSAGES, format } from '../i18n'
import type { Lang } from '../lib/paths'

interface Props {
  lang: Lang
  slides: { src: ImageMetadata; alt: string }[]
}

// FR-003: the screenshots in the hero. Without scripts it is a row that scrolls; the
// script adds the buttons, the dots and the automatic change (not with reduced motion)
const { lang, slides } = Astro.props
const t = MESSAGES[lang].screenshots
const widths = [640, 1080, 1600]
const sizes = '(min-width: 912px) 880px, calc(100vw - 32px)'
---

<div class="slider" data-slider data-pause={t.pause} data-play={t.play}>
  <ul class="slides" tabindex="0" aria-label={t.label}>
    {slides.map((slide, i) => (
      <li
        class="slide"
        aria-roledescription="slide"
        aria-label={format(t.show, { number: String(i + 1), total: String(slides.length) })}
      >
        <figure>
          <Image
            src={slide.src}
            alt={slide.alt}
            widths={widths}
            sizes={sizes}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
          <figcaption class="muted">{slide.alt}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
  <div class="controls" hidden>
    <button type="button" class="control" data-previous aria-label={t.previous}>
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>
    <div class="dots">
      {slides.map((_, i) => (
        <button
          type="button"
          class="dot"
          data-dot={i}
          aria-label={format(t.show, { number: String(i + 1), total: String(slides.length) })}
        />
      ))}
    </div>
    <button type="button" class="control" data-next aria-label={t.next}>
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
    <button type="button" class="control" data-toggle aria-label={t.pause}>
      <svg
        class="pause"
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M6 4h4v16H6zM14 4h4v16h-4z"></path>
      </svg>
      <svg
        class="play"
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M7 4v16l13-8z"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  /** Time on one slide; WCAG 2.2.2 needs the pause button because it moves by itself */
  const INTERVAL = 5000

  for (const slider of document.querySelectorAll<HTMLElement>('[data-slider]')) {
    const list = slider.querySelector<HTMLElement>('.slides')!
    const slides = [...list.children] as HTMLElement[]
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-dot]')]
    const toggle = slider.querySelector<HTMLButtonElement>('[data-toggle]')!
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    let current = 0
    let playing = !reduce
    let hold = false
    let timer: number | undefined

    slider.querySelector<HTMLElement>('.controls')!.hidden = false

    const show = (index: number) => {
      current = (index + slides.length) % slides.length
      list.scrollTo({
        left: slides[current]!.offsetLeft - list.offsetLeft,
        behavior: reduce ? 'auto' : 'smooth',
      })
      mark()
    }
    const mark = () => {
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === current)))
    }
    const schedule = () => {
      window.clearInterval(timer)
      if (playing && !hold) timer = window.setInterval(() => show(current + 1), INTERVAL)
    }
    const setPlaying = (value: boolean) => {
      playing = value
      slider.dataset.playing = String(value)
      toggle.setAttribute('aria-label', (value ? slider.dataset.pause : slider.dataset.play)!)
      schedule()
    }

    slider.querySelector('[data-previous]')!.addEventListener('click', () => {
      show(current - 1)
      schedule()
    })
    slider.querySelector('[data-next]')!.addEventListener('click', () => {
      show(current + 1)
      schedule()
    })
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i)
        schedule()
      }),
    )
    toggle.addEventListener('click', () => setPlaying(!playing))

    // A swipe or a scroll by hand: follow it when the scroll stops (not in the middle of
    // a smooth scroll that show() started)
    let settle: number | undefined
    list.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(settle)
        settle = window.setTimeout(() => {
          current = Math.round(list.scrollLeft / list.clientWidth)
          mark()
        }, 150)
      },
      { passive: true },
    )
    // Wait while the visitor looks at or uses the slider
    for (const [on, off] of [
      ['mouseenter', 'mouseleave'],
      ['focusin', 'focusout'],
    ] as const) {
      slider.addEventListener(on, () => {
        hold = true
        schedule()
      })
      slider.addEventListener(off, () => {
        hold = false
        schedule()
      })
    }

    mark()
    setPlaying(playing)
  }
</script>

<style>
  .slider {
    position: relative;
    max-width: 880px;
    margin: var(--space-6) auto 0;
  }
  .slides {
    display: flex;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }
  .slides::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  figure {
    margin: 0;
  }
  /* One height for every slide: the shape of most screenshots; a taller one shows its top */
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2880 / 1656;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  figcaption {
    margin-top: var(--space-2);
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .controls[hidden] {
    display: none;
  }
  .control {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }
  .dots {
    display: flex;
    gap: 2px;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .dot::before {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--primary) 30%, transparent);
    content: '';
  }
  .dot[aria-current='true']::before {
    background: var(--primary);
  }
  .play,
  [data-playing='true'] .pause {
    display: block;
  }
  .pause,
  [data-playing='true'] .play {
    display: none;
  }
</style>
