---
import { HOMEBREW_TAP, SCOOP_BUCKET_URL } from '../../../src/shared/project'
import { MESSAGES, format, formatSize } from '../i18n'
import { guidePage, pagePath, withBase, type Lang } from '../lib/paths'
import type { Os } from '../lib/os'
import { MAIN_KINDS, filesForOs, filesOf, type Release } from '../lib/release'
import CodeBlock from './CodeBlock.astro'
import DownloadRow from './DownloadRow.astro'
import Icon from './Icon.astro'

interface Props {
  lang: Lang
  release: Release
}

const { lang, release } = Astro.props
const t = MESSAGES[lang].download
const base = import.meta.env.BASE_URL
const guide = (slug: string, anchor = '') =>
  withBase(base, pagePath(lang, guidePage(slug))) + anchor
const systems: Os[] = ['windows', 'mac', 'linux']
const sizeOf = (bytes: number) => formatSize(bytes, lang)
const extension = filesOf(release, ['extensionChromium', 'extensionFirefox'])
const checksums = filesOf(release, ['checksums'])
// FR-014: the package managers
const commands = [
  {
    title: 'Homebrew',
    platform: t.os.mac,
    lines: [`brew tap ${HOMEBREW_TAP}`, `brew trust ${HOMEBREW_TAP}`, 'brew install --cask findy'],
  },
  {
    title: 'Scoop',
    platform: t.os.windows,
    lines: [`scoop bucket add findy ${SCOOP_BUCKET_URL}`, 'scoop install findy'],
  },
]
---

<section id="download" class="download" aria-labelledby="download-title">
  <header class="intro">
    <h2 id="download-title">{t.title}</h2>
    <p class="meta">
      <span class="pill">{format(t.version, { version: release.version })}</span>
      <span class="pill">{t.free}</span>
    </p>
  </header>

  {/* FR-011: one of these shows when the script finds the system of the visitor */}
  {systems.map((os) => {
    const files = filesOf(release, MAIN_KINDS[os])
    return (
      files.length > 0 && (
        <div class="main" data-for={os}>
          <p class="main-title">{format(t.mainFor, { os: t.os[os] })}</p>
          <div class="main-buttons">
            {files.map((file) => (
              <a class="button big" href={file.url}>
                <Icon name="download" size={20} />
                <span>
                  {t.kinds[file.kind].title}
                  <span class="size">{sizeOf(file.size)}</span>
                </span>
              </a>
            ))}
          </div>
          {os === 'mac' && (
            <p class="muted hint">
              <strong>{t.whichMac}</strong> {t.whichMacAnswer}
            </p>
          )}
        </div>
      )
    )
  })}

  {/* FR-013, FR-014, FR-015: every build, with or without scripts */}
  <h3 class="all">{t.all}</h3>
  <div class="systems">
    {systems.map((os) => {
      const files = filesForOs(release, os)
      return (
        files.length > 0 && (
          <div class="card">
            <div class="os">
              <span class="tile">
                <Icon name="monitor" size={20} />
              </span>
              <div>
                <h4>{t.os[os]}</h4>
                <p class="muted note-os">{t.osNote[os]}</p>
              </div>
              {os === 'mac' && (
                <details class="which">
                  <summary>
                    <Icon name="help" size={16} />
                    {t.whichMacShort}
                  </summary>
                  <p>{t.whichMacAnswer}</p>
                </details>
              )}
            </div>
            <ul class="rows">
              {files.map((file, i) => (
                <li>
                  <DownloadRow
                    href={file.url}
                    title={t.kinds[file.kind].title}
                    detail={t.kinds[file.kind].detail}
                    size={sizeOf(file.size)}
                    badge={i === 0 ? t.recommended : undefined}
                  />
                </li>
              ))}
            </ul>
          </div>
        )
      )
    })}
  </div>

  <div class="card wide">
    <div class="head">
      <span class="tile">
        <Icon name="terminal" size={20} />
      </span>
      <div>
        <h4>{t.packageManagers}</h4>
        <p class="muted">{t.packageManagersHint}</p>
      </div>
    </div>
    <div class="commands">
      {commands.map((command) => (
        <CodeBlock
          title={command.title}
          platform={command.platform}
          commands={command.lines}
          copy={t.copy}
          copied={t.copied}
        />
      ))}
    </div>
  </div>

  {extension.length > 0 && (
    <div class="card wide extension">
      <div class="head">
        <span class="tile">
          <Icon name="puzzle" size={20} />
        </span>
        <div>
          <h4>{t.extension}</h4>
          <p class="muted">{t.extensionHint}</p>
          <a class="button secondary small" href={guide('browser-extension')}>
            {t.howToInstall}
            <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
      <ul class="rows">
        {extension.map((file) => (
          <li>
            <DownloadRow
              href={file.url}
              title={t.kinds[file.kind].title}
              detail={t.kinds[file.kind].detail}
              size={sizeOf(file.size)}
            />
          </li>
        ))}
      </ul>
    </div>
  )}

  <p class="note">
    {t.unsigned} <a href={guide('install', `#${t.unsignedAnchor}`)}>{t.unsignedLink}</a>
  </p>
  <p class="links">
    <a href={guide('install')}>{t.installHelp}</a>
    <a href={release.pageUrl}>{t.releasePage}</a>
    {checksums.map((file) => (
      <a href={file.url}>
        {t.kinds.checksums.title} ({t.kinds.checksums.detail})
      </a>
    ))}
  </p>
</section>

<script>
  import { detectOs } from '../lib/os'

  // FR-011: mark the system of the visitor; CSS then shows its main button
  const nav = navigator as Navigator & { userAgentData?: { platform: string } }
  const os = detectOs({
    userAgent: nav.userAgent,
    platform: nav.userAgentData?.platform || nav.platform,
    maxTouchPoints: nav.maxTouchPoints,
  })
  if (os) document.documentElement.dataset.os = os
</script>

<style>
  .download {
    padding-block: var(--space-6);
  }
  .intro {
    margin-bottom: var(--space-6);
    text-align: center;
  }
  .intro h2 {
    margin: 0 0 var(--space-2);
  }
  .meta {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
  }
  .pill {
    padding: 2px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  /* The main button for the system of the visitor */
  .main {
    display: none;
    margin-bottom: var(--space-10);
    padding: var(--space-10) var(--space-6);
    border: 1px solid var(--primary-line);
    border-radius: 16px;
    background:
      radial-gradient(ellipse at top, var(--primary-soft), transparent 70%), var(--surface);
    text-align: center;
  }
  :global(html[data-os='windows']) .main[data-for='windows'],
  :global(html[data-os='mac']) .main[data-for='mac'],
  :global(html[data-os='linux']) .main[data-for='linux'] {
    display: block;
  }
  .main-title {
    margin: 0 0 var(--space-6);
    font-size: 1.5rem;
    font-weight: 700;
  }
  .main-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
  .big {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    font-size: 1.05rem;
  }
  .big .size {
    margin-left: 8px;
    font-weight: 400;
    opacity: 0.85;
  }
  .hint {
    max-width: 560px;
    margin: var(--space-6) auto 0;
    font-size: 0.9rem;
  }

  /* All the builds */
  .all {
    margin: 0 0 var(--space-4);
  }
  .systems {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }
  .card h4 {
    margin: 0;
    font-size: 1.1rem;
  }
  .wide {
    margin-bottom: var(--space-4);
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .os {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .note-os {
    margin: 2px 0 0;
    font-size: 0.85rem;
  }
  /* "Which Mac?": a small popover, so every card keeps the same height */
  .which {
    position: relative;
    align-self: flex-start;
    margin-left: auto;
  }
  .which summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--primary);
    font-size: 0.85rem;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }
  .which summary::-webkit-details-marker {
    display: none;
  }
  .which p {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 5;
    width: min(280px, 80vw);
    margin: 0;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    font-size: 0.85rem;
  }
  .commands {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-4);
  }
  .extension {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-6);
    align-items: center;
  }
  .head {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .head p {
    margin: 4px 0 0;
  }
  .tile {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--primary-soft);
    color: var(--primary);
  }
  .small {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-4);
    padding: 6px 14px;
    font-size: 0.9rem;
  }
  .note {
    margin-top: var(--space-6);
    padding: var(--space-4);
    border-left: 4px solid var(--primary);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--surface);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
</style>
