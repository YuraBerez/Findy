---
import { MESSAGES } from '../i18n'
import { LANGS, LANG_NAMES, pagePath, withBase, type Lang, type PageKey } from '../lib/paths'

interface Props {
  lang: Lang
  page: PageKey
}

// FR-020: a menu of languages; each item opens the same page in that language.
// <details> opens with the keyboard and works without scripts.
const { lang, page } = Astro.props
const t = MESSAGES[lang]
const base = import.meta.env.BASE_URL
---

<details class="language" data-language-menu>
  <summary class="control" aria-label={`${t.nav.language}: ${LANG_NAMES[lang]}`}>
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"></path>
    </svg>
    <span>{LANG_NAMES[lang]}</span>
    <svg
      class="chevron"
      aria-hidden="true"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>
  <ul>
    {LANGS.map((l) => (
      <li>
        <a
          href={withBase(base, pagePath(l, page))}
          hreflang={l}
          lang={l}
          aria-current={l === lang ? 'page' : undefined}
        >
          {LANG_NAMES[l]}
        </a>
      </li>
    ))}
  </ul>
</details>

<script>
  // Close the menu with Escape (focus goes back to it) or with a click outside it
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-language-menu]')) {
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false
        menu.querySelector('summary')?.focus()
      }
    })
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false
    })
  }
</script>

<style>
  .language {
    position: relative;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  [open] summary {
    border-color: var(--primary);
    background: var(--primary-hover);
  }
  .chevron {
    transition: transform 0.15s;
  }
  [open] .chevron {
    transform: rotate(180deg);
  }
  ul {
    position: absolute;
    right: 0;
    z-index: 5;
    min-width: 100%;
    margin: 4px 0 0;
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    list-style: none;
  }
  a {
    display: block;
    padding: 6px 12px;
    border-radius: 6px;
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
  }
  a:hover {
    background: var(--bg);
  }
  a[aria-current='page'] {
    color: var(--primary);
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }
</style>
