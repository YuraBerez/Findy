---
import logo from '../../../assets/logo.svg'
import { MESSAGES } from '../i18n'
import { guidePage, pagePath, withBase, type Lang, type PageKey } from '../lib/paths'
import LanguageSwitch from './LanguageSwitch.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  lang: Lang
  page: PageKey
}

// FR-022: the home sections and two guides here; every guide is in the footer
const { lang, page } = Astro.props
const t = MESSAGES[lang]
const base = import.meta.env.BASE_URL
const href = (key: PageKey) => withBase(base, pagePath(lang, key))
const links = [
  { href: `${href('')}#features`, text: t.nav.features, current: false },
  ...(['browser-extension', 'ai-assistant'] as const).map((slug) => ({
    href: href(guidePage(slug)),
    text: t.guides[slug],
    current: page === guidePage(slug),
  })),
]
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={href('')}>
      <img src={logo.src} alt="" width="32" height="32" />
      <span>Findy</span>
    </a>
    <nav aria-label={t.nav.label}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <LanguageSwitch lang={lang} page={page} />
      <ThemeToggle lang={lang} />
      <a class="button download" href={`${href('')}#download`}>
        {t.nav.download}
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-2);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--fg);
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
  }
  nav {
    flex: 1;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    color: var(--fg);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--primary);
    text-decoration: underline;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .download {
    padding: 7px 16px;
  }
</style>
