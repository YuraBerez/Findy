---
import logo from '../../../assets/logo.svg'
import { MESSAGES } from '../i18n'
import { GUIDES } from '../lib/guides'
import { guidePage, otherLang, pagePath, withBase, type Lang, type PageKey } from '../lib/paths'

interface Props {
  lang: Lang
  page: PageKey
}

const { lang, page } = Astro.props
const t = MESSAGES[lang]
const base = import.meta.env.BASE_URL
const href = (key: PageKey) => withBase(base, pagePath(lang, key))
const other = otherLang(lang)
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={href('')}>
      <img src={logo.src} alt="" width="32" height="32" />
      <span>Findy</span>
    </a>
    <nav aria-label={t.nav.label}>
      <ul>
        <li>
          <a href={`${href('')}#download`}>{t.nav.download}</a>
        </li>
        {GUIDES.map((slug) => (
          <li>
            <a
              href={href(guidePage(slug))}
              aria-current={page === guidePage(slug) ? 'page' : undefined}
            >
              {t.guides[slug]}
            </a>
          </li>
        ))}
        <li>
          <a href={withBase(base, pagePath(other, page))} hreflang={other} lang={other}>
            {t.nav.otherLanguage}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-2);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--fg);
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    color: var(--fg);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--primary);
    text-decoration: underline;
  }
</style>
