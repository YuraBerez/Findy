---
import { PROJECT_URL } from '../../../src/shared/project'
import logo from '../../../assets/logo.svg'
import analyticsEn from '../../../docs/screenshots/analytics-en.png'
import analyticsUk from '../../../docs/screenshots/analytics-uk.png'
import boardEn from '../../../docs/screenshots/board-en.png'
import boardUk from '../../../docs/screenshots/board-uk.png'
import detailsEn from '../../../docs/screenshots/details-en.png'
import detailsUk from '../../../docs/screenshots/details-uk.png'
import sitesEn from '../../../docs/screenshots/sites-en.png'
import sitesUk from '../../../docs/screenshots/sites-uk.png'
import { latestRelease } from '../data/release'
import { MESSAGES } from '../i18n'
import { getImage } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import { pagePath, withBase } from '../lib/paths'
import { softwareApplication } from '../lib/structuredData'
import type { Lang } from '../lib/paths'
import Closing from './Closing.astro'
import Download from './Download.astro'
import Features from './Features.astro'
import Slider from './Slider.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = MESSAGES[lang]
const release = await latestRelease()
// FR-003: the screenshots of the app in the language of the page
const shots = {
  en: { board: boardEn, details: detailsEn, analytics: analyticsEn, sites: sitesEn },
  uk: { board: boardUk, details: detailsUk, analytics: analyticsUk, sites: sitesUk },
}[lang]
const slides = (['board', 'details', 'analytics', 'sites'] as const).map((key) => ({
  src: shots[key],
  alt: t.screenshots[key],
}))
// FR-040: what search engines read about the app
const url = new URL(withBase(import.meta.env.BASE_URL, pagePath(lang)), Astro.site).href
const image = await getImage({ src: shots.board, width: 1200, format: 'png' })
const structuredData = softwareApplication({
  url,
  lang,
  description: t.meta.homeDescription,
  category: t.meta.category,
  image: new URL(image.src, Astro.site).href,
  release,
})
---

<BaseLayout
  lang={lang}
  page=""
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  structuredData={structuredData}
>
  <section class="hero container">
    <img class="logo" src={logo.src} alt="" width="64" height="64" />
    <h1>{t.hero.title}</h1>
    <p class="lead">{t.hero.lead}</p>
    <p class="muted">{t.hero.facts}</p>
    <p class="actions">
      <a class="button" href="#download">
        {t.nav.download}
      </a>
      <a class="button secondary" href={PROJECT_URL}>
        {t.hero.repository}
      </a>
    </p>
    <Slider lang={lang} slides={slides} />
  </section>

  <div class="container">
    <Features lang={lang} />
    <Download lang={lang} release={release} />

    <Closing lang={lang} />
  </div>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-10);
    text-align: center;
  }
  .hero h1 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: clamp(1.6rem, 4vw, 2.25rem);
  }
  .lead {
    max-width: 640px;
    margin: 0 auto var(--space-2);
    font-size: 1.05rem;
  }
  .hero .muted {
    margin-top: 0;
    font-size: 0.9rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  .container > :global(section) {
    margin-top: var(--space-10);
  }
</style>
