---
import { Image } from 'astro:assets'
import { SUPPORT_URL } from '../../../src/shared/project'
import logo from '../../../assets/logo.svg'
import analyticsEn from '../../../docs/screenshots/analytics-en.png'
import analyticsUk from '../../../docs/screenshots/analytics-uk.png'
import boardEn from '../../../docs/screenshots/board-en.png'
import boardUk from '../../../docs/screenshots/board-uk.png'
import detailsEn from '../../../docs/screenshots/details-en.png'
import detailsUk from '../../../docs/screenshots/details-uk.png'
import sitesEn from '../../../docs/screenshots/sites-en.png'
import sitesUk from '../../../docs/screenshots/sites-uk.png'
import { latestRelease } from '../data/release'
import { MESSAGES } from '../i18n'
import BaseLayout from '../layouts/BaseLayout.astro'
import type { Lang } from '../lib/paths'
import Download from './Download.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = MESSAGES[lang]
const release = await latestRelease()
// FR-003: the screenshots of the app in the language of the page
const shots = {
  en: { board: boardEn, details: detailsEn, analytics: analyticsEn, sites: sitesEn },
  uk: { board: boardUk, details: detailsUk, analytics: analyticsUk, sites: sitesUk },
}[lang]
const more = (['details', 'analytics', 'sites'] as const).map((key) => ({
  src: shots[key],
  alt: t.screenshots[key],
}))
const widths = [640, 1080, 1600]
const sizes = '(min-width: 1080px) 1048px, calc(100vw - 32px)'
---

<BaseLayout lang={lang} page="" title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <section class="hero container">
    <img class="logo" src={logo.src} alt="" width="96" height="96" />
    <h1>{t.hero.title}</h1>
    <p class="lead">{t.hero.lead}</p>
    <p class="muted">{t.hero.facts}</p>
    <p>
      <a class="button" href="#download">
        {t.nav.download}
      </a>
    </p>
    <figure>
      <Image
        src={shots.board}
        alt={t.screenshots.board}
        widths={widths}
        sizes={sizes}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <div class="container">
    <Download lang={lang} release={release} />

    <section aria-labelledby="features-title">
      <h2 id="features-title">{t.features.title}</h2>
      <div class="features">
        {t.features.items.map((item) => (
          <div class="feature">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="screenshots-title">
      <h2 id="screenshots-title">{t.screenshots.title}</h2>
      {more.map((shot) => (
        <figure>
          <Image src={shot.src} alt={shot.alt} widths={widths} sizes={sizes} loading="lazy" />
          <figcaption class="muted">{shot.alt}</figcaption>
        </figure>
      ))}
    </section>

    <section aria-labelledby="privacy-title">
      <h2 id="privacy-title">{t.privacy.title}</h2>
      <p>{t.privacy.text}</p>
    </section>

    <section aria-labelledby="support-title">
      <h2 id="support-title">{t.support.title}</h2>
      <p>{t.support.text}</p>
      <p>
        <a class="button" href={SUPPORT_URL}>
          {t.support.button}
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-10);
    text-align: center;
  }
  .hero h1 {
    margin: var(--space-4) 0;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
  }
  .lead {
    max-width: 720px;
    margin: 0 auto var(--space-4);
    font-size: 1.15rem;
  }
  figure {
    margin: var(--space-6) 0;
  }
  figure :global(img) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-4);
  }
  .feature {
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .feature h3 {
    margin-top: 0;
    font-size: 1.05rem;
  }
  section {
    margin-top: var(--space-10);
  }
  .hero {
    margin-top: 0;
  }
</style>
