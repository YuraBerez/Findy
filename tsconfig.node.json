{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/domain/**/*",
    "tests/unit/**/*"
  ],
  // Unit tests of pure renderer and extension modules need the DOM types:
  // tsconfig.web.json and tsconfig.extension.json
  "exclude": ["tests/unit/renderer/**/*", "tests/unit/extension/**/*"]
}
